// Objetivo: programa completo comentado da seção 25.1.
// Esperado: árvore sem erro.
hauda cava { // Inicia as declarações de recursos da placa.
    leper_car led = leper(13) : dammë; // Saída 13, inicialmente baixa.
} // Encerra as declarações de recursos.

glanna canat_min limite = 3; // Constante sem sinal de 8 bits, com valor 3.

car canat_min somar(canat_min primeiro, canat_min segundo) cava { // Recebe dois valores.
    auta primeiro + segundo; // Retorna a soma dos argumentos.
} // Encerra a função somar.

car aba_car mostrar(canat_min valor) cava { // Procedimento sem valor de retorno.
    ela pet_lanca valor; // Imprime o número e uma quebra de linha LF.
} // Encerra o procedimento mostrar.

minya cava { // Executa uma vez, ao iniciar o programa.
    minya_lambë 9600; // Inicializa a comunicação serial a 9600 baud.
} // Encerra a inicialização.

vola cava { // Repete este bloco enquanto a placa estiver funcionando.
    [canat_min; 3] valores = [1, 2, 3]; // Cria um vetor com três elementos.

    vola_delia (canat_min indice = 0; // Inicializa o índice do laço em zero.
            indice < limite; // Repete enquanto o índice for menor que 3.
            indice = indice + 1) cava { // Incrementa após cada iteração.

        né_cava indice == 1 cava { // Verifica se chegou ao segundo elemento.
            vola_minya; // Pula o restante; segue para o incremento.
        } // Encerra a condição.
        ela mostrar(valores[indice]); // Imprime o elemento: 1 ou 3.
    } // Encerra o laço de percurso do vetor.

    canat_min valor = somar(1, 1); // Chama somar e guarda o resultado 2.

    car_heco valor cava { // Seleciona um caso conforme o valor calculado.
        car_min 2 cava { // Executa este caso quando valor for igual a 2.
            ela car_duimë duimë han led; // Coloca a saída do LED em nível alto.
        } // Encerra o caso; não passa para o próximo.
        heco cava { // Executaria se nenhum caso correspondesse.
            ela car_duimë dammë han led; // Coloca a saída em nível baixo.
        } // Encerra o caso padrão.
    } // Encerra a seleção.

    vola_car cava { // Executa o corpo antes de testar a condição.
        valor = valor - 1; // Reduz valor: primeiro para 1, depois 0.
    } vola_né valor > 0; // Repete somente enquanto valor for positivo.

    vola_né né cava { // Inicia um laço cuja condição é sempre verdadeira.
        ela mostrar(valor); // Imprime 0, que resultou do laço anterior.
        lanca; // Sai imediatamente deste laço.
    } // Encerra o laço interrompido por lanca.

    vola_canat 2 cava { // Executa o corpo exatamente duas vezes.
        ela pet_lanca "Ola"; // Imprime Ola seguido de LF.
    } // Encerra a repetição contada.

    ela lúmë_dammë lúmë(1, 1); // Aguarda 1/1 segundo, isto é, 1000 ms.
} // Encerra o ciclo; vola será executado novamente.
